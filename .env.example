# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
REACT_APP_SUPABASE_URL=your-project-url.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Note: The anon key is safe to expose in frontend code as it's protected by Row Level Security (RLS)

# Web Push (VAPID) — generate a keypair and paste the public key here.
# See docs/push-notifications-setup.md for instructions.
REACT_APP_VAPID_PUBLIC_KEY=
